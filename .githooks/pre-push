#!/usr/bin/env bash
#
# pre-push hook — runs the Claude `swift-code-reviewer` agent against the Swift
# files being pushed and blocks the push if the review verdict is FAIL.
#
# It uses whichever supported agent CLI is installed, preferring Claude Code,
# then falling back to the GitHub Copilot CLI.
#
# Enable once per clone (already version-controlled under .githooks/):
#     git config core.hooksPath .githooks
#
# Escape hatches:
#     git push --no-verify        # skip all pre-push hooks
#     SKIP_CLAUDE_REVIEW=1 git push
#     SKIP_COPILOT_REVIEW=1 git push
#     SKIP_AI_REVIEW=1 git push   # skip regardless of which CLI is used
#
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"

if [ "${SKIP_AI_REVIEW:-}" = "1" ] \
    || [ "${SKIP_CLAUDE_REVIEW:-}" = "1" ] \
    || [ "${SKIP_COPILOT_REVIEW:-}" = "1" ]; then
    echo "pre-push: AI review skip flag set — skipping Swift code review."
    exit 0
fi

# Pick an available agent CLI, preferring Claude Code, then GitHub Copilot.
if command -v claude >/dev/null 2>&1; then
    REVIEW_CLI="claude"
elif command -v copilot >/dev/null 2>&1; then
    REVIEW_CLI="copilot"
else
    echo "pre-push: ❌ no supported AI review CLI found ('claude' or 'copilot')." >&2
    echo "          The Swift code review is required before pushing." >&2
    echo "          Install Claude Code or the GitHub Copilot CLI to enable it," >&2
    echo "          or bypass with: AI_REVIEW_FAILOPEN=1 git push  /  git push --no-verify" >&2
    [ "${AI_REVIEW_FAILOPEN:-}" = "1" ] && { echo "pre-push: AI_REVIEW_FAILOPEN=1 — allowing push." >&2; exit 0; }
    exit 1
fi

# Collect changed *.swift files across every ref being pushed (stdin format:
# <local_ref> <local_sha> <remote_ref> <remote_sha>).
changed_files=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue          # branch deletion, nothing to review

    if [ "$remote_sha" = "$ZERO" ]; then            # new branch on remote
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null \
                || git rev-list --max-parents=0 "$local_sha" | tail -1)"
    else
        base="$remote_sha"
    fi

    files="$(git diff --name-only "$base" "$local_sha" -- '*.swift' 2>/dev/null || true)"
    changed_files="$(printf '%s\n%s' "$changed_files" "$files")"
done

# De-duplicate and drop blank lines / deleted files.
changed_files="$(printf '%s\n' "$changed_files" | sort -u | grep -E '\.swift$' || true)"
existing=""
while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && existing="$(printf '%s\n%s' "$existing" "$f")"
done <<< "$changed_files"
changed_files="$(printf '%s\n' "$existing" | grep -E '\.swift$' || true)"

if [ -z "$changed_files" ]; then
    echo "pre-push: no Swift changes to review — allowing push."
    exit 0
fi

echo "pre-push: reviewing Swift changes with the swift-code-reviewer agent (${REVIEW_CLI})..."
echo "$changed_files" | sed 's/^/  • /'

file_list="$(printf '%s' "$changed_files" | paste -sd ',' -)"

prompt="Use the swift-code-review skill to review these changed Swift files \
against the repo coding standards, then emit the verdict token: ${file_list}"

# Run headless, read-only. Reads/greps/git are all this review needs.
if [ "$REVIEW_CLI" = "claude" ]; then
    output="$(claude -p "$prompt" \
        --agents swift-code-reviewer \
        --allowedTools "Read,Grep,Glob,Bash(git diff:*),Bash(git grep:*),Bash(grep:*)" \
        --output-format text 2>&1)" || {
            echo "pre-push: ❌ Claude review could not run:" >&2
            echo "$output" >&2
            echo "pre-push: blocking push (review inconclusive). Bypass: AI_REVIEW_FAILOPEN=1 git push  /  git push --no-verify" >&2
            [ "${AI_REVIEW_FAILOPEN:-}" = "1" ] && exit 0
            exit 1
        }
else
    output="$(copilot -p "$prompt" \
        --agent swift-code-reviewer \
        --allow-tool "view" --allow-tool "grep" --allow-tool "glob" \
        --allow-tool "shell(git diff)" --allow-tool "shell(git grep)" \
        --allow-tool "shell(grep)" \
        --no-color 2>&1)" || {
            echo "pre-push: ❌ Copilot review could not run:" >&2
            echo "$output" >&2
            echo "pre-push: blocking push (review inconclusive). Bypass: AI_REVIEW_FAILOPEN=1 git push  /  git push --no-verify" >&2
            [ "${AI_REVIEW_FAILOPEN:-}" = "1" ] && exit 0
            exit 1
        }
fi

echo "----------------------------------------------------------------------"
echo "$output"
echo "----------------------------------------------------------------------"

verdict="$(printf '%s\n' "$output" \
    | grep -Eo '(CLAUDE|COPILOT)_REVIEW_VERDICT: (PASS|FAIL)' | tail -1)"

case "$verdict" in
    *PASS)
        echo "pre-push: ✅ review passed — pushing."
        exit 0
        ;;
    *FAIL)
        echo "pre-push: ❌ review found blocking violations — push blocked." >&2
        echo "          Fix the issues above, or bypass with: git push --no-verify" >&2
        exit 1
        ;;
    *)
        echo "pre-push: ❌ no clear verdict from review — blocking push." >&2
        echo "          Re-run, or bypass with: AI_REVIEW_FAILOPEN=1 git push  /  git push --no-verify" >&2
        [ "${AI_REVIEW_FAILOPEN:-}" = "1" ] && { echo "pre-push: AI_REVIEW_FAILOPEN=1 — allowing push." >&2; exit 0; }
        exit 1
        ;;
esac
