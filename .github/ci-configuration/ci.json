{
    "platform": "ios",
    "common": [
        {
            "runs-on": ["macos-26"],
            "checkout": {
                "path": "./"
            }
        }
    ],

    "build": [
        {
            "name": "Build Source Code",
            "type": "fastlane",
            "prescript": ".github/scripts/runnerinfo.sh",
            "fastlane": {
                "lane": "buildiOSSource",
                "working_repo": "./",
                "fastlane_repo": "awasthi027/iosBuildScripts"
            }
        }
    ],

    "test": [
        {
            "name": "Run Unit Tests",
            "type": "fastlane",
            "disabled": true,
            "fastlane": {
                "lane": "testiOSSource",
                "working_repo": "./",
                "fastlane_repo": "awasthi027/iosBuildScripts"
            }
        },
        {
            "name": "Run UI Tests",
            "type": "fastlane",
            "disabled": true,
            "fastlane": {
                "lane": "testiOSSource",
                "env": ".env.UITest",
                "working_repo": "./",
                "fastlane_repo": "awasthi027/iosBuildScripts"
            }
        },
        {
            "name": "Pod Lib Lint",
            "type": "fastlane",
            "disabled": true,
            "fastlane": {
                "lane": "podLibLint",
                "working_repo": "./",
                "fastlane_repo": "awasthi027/iosBuildScripts"
            }
        }
    ]
}

